/* ===== Easy-operation assistant: explanation only, never robot control ===== */
function toggleAiChat(force){
  const panel=$("aiChatPanel"),open=typeof force==="boolean"?force:!panel.classList.contains("open");panel.classList.toggle("open",open);if(open)setTimeout(()=>$("aiChatInput").focus(),120);
}
function addChatMessage(text,who="bot",note=""){
  const row=document.createElement("div");row.className=`ai-msg ${who}`;row.textContent=text;if(note){const small=document.createElement("small");small.textContent=note;row.appendChild(small)}$("aiChatMessages").appendChild(row);$("aiChatMessages").scrollTop=$("aiChatMessages").scrollHeight;
}
function getAiDashboardState(){
  return{data_source:state.demo?"DEMO MODE":"LIVE WebSocket",mode:state.mode,system:state.system,joints:state.robot.joints,gripper:state.gripper,vision:state.vision,path:state.path,alerts:getAlerts(),can_health:state.can_health,teaching_quality:getTeachingQuality(),approach:getApproachGuide()};
}
function localEasyAssistant(question){
  const q=question.toLowerCase(),j3=state.robot.joints.find(j=>j.id==="J3"),a=getApproachGuide(),alerts=getAlerts(),source=state.demo?"현재 화면은 DEMO MODE 샘플 데이터입니다. 실제 장비 측정값은 아닙니다.":"현재 화면은 WebSocket으로 수신한 LIVE 데이터입니다.";
  if(q.includes("발표"))return `${source}\n\n[한 줄 설명]\n이 시스템은 MPU 티칭, 그리퍼 카메라 AI 인식, CAN 통신, 6축 서보 피드백을 한 화면에서 연결해 보여주는 로봇팔 자동 분류 시스템입니다.\n\n[현장 흐름]\n사람 동작 티칭 → 물체 감지 → 위치 보정 → 접근 → 집기 → 분류통 배치`;
  if(q.includes("can"))return `${source}\n\n[현재 상태]\nCAN 상태: ${state.system.can_status==="OK"?"정상":"확인 필요"}\n최근 수신: ${state.can_health.last_rx_ms} ms\n오류: ${state.can_health.errors}건\n\n[설명]\nCAN은 Raspberry Pi 쪽 판단 결과와 하위 제어기의 모터·센서 상태를 주고받는 통신 통로입니다.`;
  if(q.includes("j3")||q.includes("모터"))return `${source}\n\n[J3 Elbow]\n현재각 ${deg(j3.current)} / 목표각 ${deg(j3.target)}\n온도 ${fmt(j3.temp,0)}°C / 부하 ${fmt(j3.load,0)}%\n\n[판단]\n${j3.load>=80?"부하가 80% 이상입니다. 팔꿈치 축 간섭이나 작업물 저항을 먼저 확인하세요.":"현재 즉시 조치가 필요한 부하는 아닙니다."}`;
  if(q.includes("그리퍼")||q.includes("집"))return `${source}\n\n[그리퍼 판단]\nToF 거리: ${fmt(state.gripper.tof_mm)} mm\n대상: ${objectLabel(state.vision.target)} ${(state.vision.confidence*100).toFixed(0)}%\n판단: ${a.ready?"집기 가능":a.label}\n\n[다음 확인]\n안정 검출 ${state.vision.stable_frames}/3 프레임과 위치 보정값을 함께 확인하세요.`;
  return `${source}\n\n[현재 요약]\n모드: ${state.mode}\n현재 단계: ${STEP_LABELS[state.path.current_step]||state.path.current_step}\n알림: ${alerts.length?alerts.map(x=>x.text).join(" / "):"즉시 조치가 필요한 경고 없음"}\n\n[먼저 볼 것]\nCAN 상태, J3 부하, ToF 거리, 안정 검출 3/3 여부를 순서대로 확인하세요.`;
}
async function submitAiChat(event){
  event.preventDefault();const input=$("aiChatInput"),question=input.value.trim();if(!question)return;input.value="";addChatMessage(question,"user");
  try{
    const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),45000);
    const res=await fetch("/api/chat",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({question,dashboard:getAiDashboardState()}),signal:controller.signal});clearTimeout(timer);
    if(!res.ok)throw Error(`HTTP ${res.status}`);const data=await res.json();addChatMessage(data.reply||data.message||localEasyAssistant(question),"bot","서버 응답");
  }catch{addChatMessage(localEasyAssistant(question),"bot","로컬 안내 · 서버 미연결 fallback")}
}
function askQuick(question){toggleAiChat(true);$("aiChatInput").value=question;submitAiChat({preventDefault(){}})}

/* ===== WebSocket: structured payload and old flat payload compatibility ===== */
function getWsUrl(){
  const host=location.hostname&&location.hostname!=="localhost"&&location.hostname!=="127.0.0.1"?location.hostname:"localhost";
  return `ws://${host}:8765`;
}
function connectWS(){
  const wsUrl=getWsUrl();
  let ws;try{ws=new WebSocket(wsUrl)}catch{return}
  state.ws=ws;
  ws.onopen=()=>{state.demo=false;state.system.server_connected=true;addLog("서버 연결 — 실제 데이터 수신 대기","ok");debug("WebSocket connected");renderAll()};
  ws.onmessage=e=>{try{const d=JSON.parse(e.data);applyIncoming(d);state.demo=false;state.system.server_connected=true;state.lastFrame=Date.now();renderAll()}catch(err){debug("JSON parse error: "+err.message)}};
  ws.onclose=()=>{state.demo=true;state.system.server_connected=false;debug(`${wsUrl} disconnected. DEMO MODE enabled.`);renderAll();setTimeout(connectWS,2400)};
  ws.onerror=()=>{try{ws.close()}catch{}};
}
function applyIncoming(d){
  if(d.mode)setMode(d.mode,true);if(d.system)Object.assign(state.system,d.system);
  if(d.robot?.joints){d.robot.joints.forEach(n=>{const j=state.robot.joints.find(x=>x.id===n.id);if(j)Object.assign(j,n)});if(d.robot.end_effector)state.robot.end_effector=d.robot.end_effector}
  else state.robot.joints.forEach(j=>{if(d[j.id]!=null){j.current=Number(d[j.id]);j.target=Number(d[j.id])}});
  if(d.digital_twin)Object.assign(state.digital_twin,d.digital_twin);
  if(d.command?.motor_id&&d.command.angle_deg!=null){const j=state.robot.joints[d.command.motor_id-1];if(j){j.target=Number(d.command.angle_deg);state.digital_twin.last_cmd=`CMD_SET_ANGLE M${d.command.motor_id} ${fmt(j.target)}°`}}
  if(d.can_frame)applyCanFrame(d.can_frame);
  if(d.human_pose)Object.assign(state.human_pose,d.human_pose);if(d.gripper)Object.assign(state.gripper,typeof d.gripper==="string"?{state:d.gripper.toUpperCase()}:d.gripper);
  if(d.vision){Object.assign(state.vision,d.vision);if(d.vision.correction)Object.assign(state.vision.correction,d.vision.correction)}
  if(d.path)Object.assign(state.path,d.path);if(d.precheck)Object.assign(state.precheck,d.precheck);if(d.can_health)Object.assign(state.can_health,d.can_health);if(d.calibration)Object.assign(state.calibration,d.calibration);if(Array.isArray(d.alerts))state.alerts=d.alerts;
  if(d.event?.message)addLog(d.event.message,(d.event.level||"INFO").toLowerCase());
}

function applyCanFrame(frame){
  const id=typeof frame.id==="string"?parseInt(frame.id,16):Number(frame.id),data=frame.data||[];
  if(id===0x201&&data.length>=7){
    const motorId=data[0],angle=((data[2]<<8)|data[1])/10,temp=data[3],load=(data[5]<<8)|data[4],flags=data[6],j=state.robot.joints[motorId-1];
    if(j){if(flags&1)j.current=angle;if(flags&2)j.temp=temp;if(flags&4)j.load=Math.min(100,Math.round(load/10));j.status=j.load>=80?"WARN":"OK"}
    state.digital_twin.last_ack=`STM 0x201 M${motorId} 피드백`;
  }else if(id===0x202&&data.length>=4){
    const motorId=data[0],raw=(data[2]<<8)|data[1],ok=!!data[3],j=state.robot.joints[motorId-1];
    if(j&&ok){j.current_ma=Math.round(raw*6.5);state.digital_twin.current_id="0x202 OK"}
  }else if(id===0x200){
    state.digital_twin.last_ack="STM ACK 0x200 OK";
  }
}

/* ===== Demo data: visibly labeled, never presented as hardware data ===== */
function demoTick(now){
  if(!state.demo||state.system.estop||state.mode==="MANUAL")return;simT+=.018;
  state.robot.joints.forEach((j,i)=>{const home=TWIN_HOME_ANGLES[i];j.current=home;j.target=home;j.temp=clamp(j.temp+(Math.random()-.5)*.08,35,52);j.load=clamp(j.load+(Math.random()-.5)*.5,18,62);j.status="OK"});
  const h=state.human_pose;h.shoulder_motion=42+Math.sin(simT*.8)*7;h.elbow_bend=78+Math.sin(simT*.92)*11;h.wrist_direction=15+Math.cos(simT)*8;h.hand_delta_x=12+Math.sin(simT)*5;h.hand_delta_y=-8+Math.cos(simT*.7)*4;h.mpu.forEach((m,i)=>{m.yaw+=Math.sin(simT+i)*.04;m.pitch+=Math.cos(simT*.7+i)*.05});
  state.gripper.tof_mm=48.2+Math.sin(simT*.8)*2.2;state.vision.confidence=.91+Math.sin(simT)*.03;state.vision.correction.dx_mm=2.1+Math.sin(simT*.6)*.8;state.vision.correction.dy_mm=-1.8+Math.cos(simT*.5)*.6;
  state.can_health.received+=Math.floor(Math.random()*3);state.can_health.last_rx_ms=Math.round(16+Math.abs(Math.sin(simT))*12);state.can_health.delay_ms=Math.round(12+Math.abs(Math.cos(simT*.7))*10);
  if(now-lastAutoLog>9000){lastAutoLog=now;const pool=state.mode==="TEACHING"?[["MPU 자세 추정 안정 — 로봇 목표각 변환 중","info"],["WP 저장 준비 완료","ok"]]:[["볼트 감지, 신뢰도 94%","ok"],["위치 보정 X +2.1 mm / Y -1.8 mm","warn"],["ToF 거리 48.2 mm — 접근 가능","info"]];const [m,t]=pool[Math.floor(simT)%pool.length];addLog(m,t)}
}

/* ===== Main render loop ===== */
function renderAll(){
  renderHeader();renderPrimary();renderPath();renderRightPanel();if(state.mode==="MANUAL")renderManualRows();applyFocusView();
}
function frame(now){demoTick(now);drawHumanPose();drawGripper();draw3D();drawTopDown();renderRightPanel();requestAnimationFrame(frame)}
setInterval(()=>{const now=currentTime();setText("clock",now);const sc=$("splashClock");if(sc)sc.textContent=now;const timer=$("recordTimer");if(timer){const s=Math.floor((Date.now()-bootTime)/1000);timer.textContent=`${String(Math.floor(s/60)).padStart(2,"0")}:${String(s%60).padStart(2,"0")}`}},1000);
const bootTime=Date.now();
const initialWsUrl=getWsUrl();if($("wsUrlLabel"))$("wsUrlLabel").textContent=initialWsUrl;
addLog("시뮬레이션 데이터 표시 — 서버 연결 대기","warn");addLog(`WebSocket ${initialWsUrl} 연결 대기`,"info");addLog("6축 STS3215 상태 패널 준비 완료","ok");
renderAll();bind3DDrag();connectWS();requestAnimationFrame(frame);
</script>
