  const hand={x:wrist.x+Math.cos(wristA-.16)*scale*.075,y:wrist.y+Math.sin(wristA-.16)*scale*.075};
  const pts={head:{x:cx,y:headY},neck,leftShoulder,shoulder,elbow,wrist,hand,lh:{x:cx-scale*.1,y:hipY},rh:{x:cx+scale*.1,y:hipY}};
  const lines=[["head","neck"],["neck","leftShoulder"],["neck","shoulder"],["leftShoulder","lh"],["shoulder","rh"],["lh","rh"],["shoulder","elbow"],["elbow","wrist"],["wrist","hand"]];
  ctx.lineCap="round";lines.forEach(([a,b],i)=>{const active=i>5;ctx.strokeStyle=active?"rgba(74,222,128,.94)":"rgba(135,167,191,.44)";ctx.lineWidth=active?7:5;ctx.shadowBlur=active?10:0;ctx.shadowColor="#4ade80";ctx.beginPath();ctx.moveTo(pts[a].x,pts[a].y);ctx.lineTo(pts[b].x,pts[b].y);ctx.stroke()});ctx.shadowBlur=0;
  Object.entries(pts).forEach(([k,p])=>{ctx.fillStyle=["shoulder","elbow","wrist","hand"].includes(k)?"#4ade80":"#d9e9f5";ctx.beginPath();ctx.arc(p.x,p.y,k==="hand"?6:5,0,Math.PI*2);ctx.fill()});
  ctx.strokeStyle="rgba(32,213,232,.52)";ctx.setLineDash([7,6]);ctx.strokeRect(W*.2,H*.1,W*.58,H*.76);ctx.setLineDash([]);
  ctx.font="12px Consolas";ctx.fillStyle="#4ade80";ctx.fillText(`어깨 추정 ${fmt(hp.shoulder_motion)}°`,shoulder.x+10,shoulder.y-9);ctx.fillText(`팔꿈치 추정 ${fmt(hp.elbow_bend)}°`,elbow.x+10,elbow.y-9);ctx.fillText(`손목 추정 ${fmt(hp.wrist_direction)}°`,wrist.x+10,wrist.y-9);
  const cardW=Math.min(322,Math.max(276,W*.33)),cardX=W-cardW-14,cardY=54,rowH=25;
  ctx.fillStyle="rgba(5,12,20,.86)";ctx.fillRect(cardX,cardY,cardW,132);ctx.strokeStyle="rgba(28,56,85,.92)";ctx.strokeRect(cardX,cardY,cardW,132);
  ctx.fillStyle="#83a0b6";ctx.font="bold 11px Malgun Gothic, Segoe UI";ctx.fillText("MPU 센서 자세값 / Pose Estimate",cardX+12,cardY+20);
  (hp.mpu||[]).forEach((m,i)=>{
    const y=cardY+49+i*rowH;
