    ctx.fillStyle="#d9e9f5";ctx.font="10px Consolas";ctx.textAlign="right";ctx.fillText(`Y ${signed(m.yaw)}°   P ${signed(m.pitch)}°   R ${signed(m.roll)}°`,cardX+cardW-12,y);
  });
